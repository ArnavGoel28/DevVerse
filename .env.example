# Copy this file to .env.local and fill in the values.
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK config.
# These four are public (safe in the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Server-only secrets (never NEXT_PUBLIC_) — docs/07-tech-stack.md §5 ----
# Gemini key from Google AI Studio. Without it, profiles are rules-based (still fully working).
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash).
# GEMINI_MODEL=
# Or bill through Cloud Billing via Vertex AI, using FIREBASE_SERVICE_ACCOUNT (needs the "Vertex AI User" role).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=global
# Optional daily AI caps (NFR-AI-05): signed-in users / demo visitors per IP. Defaults 40 / 15.
# AI_DAILY_LIMIT=40
# AI_DEMO_DAILY_LIMIT=15
# Service-account JSON on ONE line (Firebase console -> Project settings -> Service accounts).
# Not needed on Firebase App Hosting. Without it, only the no-sign-in demo works.
FIREBASE_SERVICE_ACCOUNT=
# Any long random string (32+ chars). Encrypts users' GitHub tokens at rest.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Optional: a GitHub token with NO scopes, used only for the public demo to avoid the 60 requests/hour limit.
# GITHUB_DEMO_TOKEN=
# Added in later blocks:
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=
